#!/usr/bin/env bash
# Operate CLI for the lwcc site, per lab980 conventions.
# Symlink onto PATH on the droplet:  ln -sf /var/www/lwcc/bin/lwcc /usr/local/bin/lwcc
set -euo pipefail
# Resolve the symlink (/usr/local/bin/lwcc -> repo) before locating the repo.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

case "${1:-}" in
  redeploy)
    cd "$DIR"
    if [ ! -d .git ]; then
      echo "error: $DIR is not a git clone — adopt it in place first:" >&2
      echo "  cd $DIR && git init -b main && git remote add origin <repo-url>" >&2
      echo "  git fetch origin && git reset --hard origin/main" >&2
      echo "  git branch --set-upstream-to=origin/main main" >&2
      echo "(.env and uploaded guides are untracked and survive the reset)" >&2
      exit 1
    fi
    git pull --ff-only
    pm2 restart lwcc --update-env
    pm2 save
    ;;
  restart) pm2 restart lwcc ;;
  logs)    pm2 logs lwcc --lines "${2:-100}" ;;
  status)  pm2 describe lwcc ;;
  *)
    echo "usage: lwcc {redeploy|restart|logs [n]|status}" >&2
    exit 2
    ;;
esac
