#!/usr/bin/env bash
# lwcc — operate CLI for lwcc.lab980.com (worship guides).
#
# A proxied app site: nginx fronts a pm2-managed Python process (app.py,
# stdlib only) on 127.0.0.1:8069. Bring-up is `provision-site` (see lab980's
# CLAUDE.md); this script owns everything after that:
#
#   lwcc deploy    fast-forward to origin/main -> pm2 start/restart -> probe -> save
#   lwcc redeploy  the same (kept as an alias — it was the old name)
#   lwcc restart   pm2 restart + probe, no code change
#   lwcc logs [n]  tail the pm2 logs for this app (n lines, default 100)
#   lwcc status    HEAD, pm2 state, .env key presence, local + public probe, cert days
#
# Env overrides:
#   LWCC_FQDN          default lwcc.lab980.com
#   LWCC_BRANCH        default main
#   LWCC_PORT          default 8069
#   LWCC_PROBE_TRIES   default 10 (one second apart)
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/lwcc) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${LWCC_FQDN:-lwcc.lab980.com}"
BRANCH="${LWCC_BRANCH:-main}"
PORT="${LWCC_PORT:-8069}"
PROBE_TRIES="${LWCC_PROBE_TRIES:-10}"
APP="lwcc"
ENV_FILE="$ROOT/.env"

# The `pm2 start` argv that registers this app the FIRST time. Every later
# deploy is a `pm2 restart $APP` of that registration, but on a fresh box (or
# after `pm2 delete`) nothing is registered and restart fails.
#
# This reproduces the live registration on the droplet (and what
# ecosystem.config.cjs describes): app.py under python3, fork mode, a 200M
# memory ceiling, `--port 8069` as the script's own argument. Everything else
# the app wants (UPLOAD_TOKEN, ANTHROPIC_API_KEY, CONVERT_WORKERS, …) it reads
# from ./.env itself; the launch below is scrubbed (see pm2_clean).
START_CMD=(app.py --name "$APP" --interpreter python3 --max-memory-restart 200M -- --port "$PORT")

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
lwcc — operate lwcc.lab980.com (python app under pm2, behind nginx).

Usage:
  lwcc deploy           fast-forward to origin/main, pm2 start/restart, probe, save
  lwcc redeploy         alias of deploy (the old name)
  lwcc restart          pm2 restart + probe
  lwcc logs [n]         tail pm2 logs (n lines, default 100; other pm2 logs flags pass through)
  lwcc status           HEAD + pm2 + .env keys + local/public probe + cert

The app reads UPLOAD_TOKEN, ANTHROPIC_API_KEY and the *_WORKERS settings from
./.env (see .env.example); nothing comes from the shell that runs this.

Env: LWCC_FQDN, LWCC_BRANCH (default main), LWCC_PORT (default 8069),
     LWCC_PROBE_TRIES (default 10).
USAGE
}

# The app runs as root under pm2, and pm2 keeps one daemon, process list and
# dump PER HOME — root's is /root/.pm2. Run as anyone else, or as uid 0 with
# someone else's HOME (`su root` without `-`, `sudo` preserving HOME), and
# every pm2 call here talks to a different daemon: `status` says "not
# registered" while the site is up, and `deploy` starts a second copy.
need_root() {
  [ "$(id -u)" -eq 0 ] || die "$1 must run as root (the app's pm2 daemon is root's)."
  local rhome; rhome="$(getent passwd root | cut -d: -f6)"
  [ -n "${PM2_HOME:-}" ] || [ "${HOME:-}" = "$rhome" ] \
    || die "$1: HOME is '${HOME:-}' but root's home is $rhome — pm2 keys its daemon and dump off HOME, so this would talk to a different pm2. Use \`sudo -i\` or \`su -\` (or set PM2_HOME on purpose)."
}

# ---------------------------------------------------------------------------
# pm2. Every pm2 call goes through pm2_clean, which launches it from an EMPTY
# environment plus the handful of variables pm2 itself needs, PORT, and
# PYTHONUNBUFFERED. pm2 copies the environment of the `pm2 start` call into
# the process, and from there into ~/.pm2/dump.pm2 on save — so a plain `pm2
# start` (or `pm2 restart --update-env`, which re-captures the shell on every
# deploy) would give whatever the calling shell carried an indefinite on-disk
# lifetime in the dump. The daemon itself keeps the environment of whichever
# call first spawned it, which is why jlist and logs go through here as well.
#
# PORT is handed in because it is not a secret and this script knows it
# (app.py also takes it as --port, which wins). PYTHONUNBUFFERED=1 is what
# the live registration carries, so the app's prints reach the pm2 log as
# they happen instead of when a block-buffered stdout flushes. Everything
# else — UPLOAD_TOKEN, ANTHROPIC_API_KEY — the app reads from ./.env itself,
# never from the shell that ran this script.
# ---------------------------------------------------------------------------
pm2_clean() {
  env -i PATH="$PATH" HOME="$HOME" ${PM2_HOME:+PM2_HOME="$PM2_HOME"} \
    ${TERM:+TERM="$TERM"} LANG=C.UTF-8 PORT="$PORT" PYTHONUNBUFFERED=1 pm2 "$@"
}

# `pm2 jlist` is JSON only on a good day: pm2 writes chatter to STDOUT ahead
# of it — `[PM2] Spawning PM2 daemon…` when the daemon was down, `>>>> In-memory
# PM2 is out-of-date` after a pm2 upgrade. So the JSON is taken from the first
# line that starts one and parses; anything else is reported as unknown (exit
# 1), never guessed as "not registered" — deploy would answer that guess with
# a second `pm2 start` against a live app.
PM2_JSON='import json, sys
lines = sys.stdin.read().split("\n")
for i, line in enumerate(lines):
    if line[:1] in "[{":
        try:
            procs = json.loads("\n".join(lines[i:]))
        except ValueError:
            continue
        if isinstance(procs, list):
            json.dump(procs, sys.stdout); sys.exit(0)
sys.exit("no parseable JSON in pm2 jlist output")'
pm2_jlist() {   # -> JSON array on stdout; 1 with the reason on stderr
  local jl
  jl="$(pm2_clean jlist 2>/dev/null)" || { echo "pm2 jlist failed" >&2; return 1; }
  printf '%s' "$jl" | python3 -c "$PM2_JSON"
}

# "not registered", "<status>  mode=…", or "unknown (…)" with exit 1.
pm2_state() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf 'unknown (%s)\n' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
p = [x for x in json.load(sys.stdin) if x.get("name") == sys.argv[1]]
if not p: print("not registered"); raise SystemExit
e = p[0].get("pm2_env", {})
print("%s  mode=%s  restarts=%s  uptime-since=%s" % (
  e.get("status"), e.get("exec_mode"), e.get("restart_time"), e.get("pm_uptime")))' "$APP"
}

# Names of registered processes that are not online (empty = all online);
# exit 1 with the reason when the list cannot be read.
pm2_not_online() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf '%s' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
print(" ".join(x.get("name", "?") for x in json.load(sys.stdin)
               if x.get("pm2_env", {}).get("status") != "online"))'
}

save_if_online() {
  # pm2 save overwrites the dump with whatever is running right now, so a save
  # while anything is down persists a dump that comes back short on the next
  # reboot. The box rule (lab980 CLAUDE.md) is EVERY app online before a save,
  # not just this one; otherwise say so and leave the previous dump alone.
  local bad
  if ! bad="$(pm2_not_online)"; then
    warn "skipping pm2 save: cannot read the pm2 process list ($bad)"; return 0
  fi
  if [ -n "$bad" ]; then
    warn "not every pm2 process is online ($bad) — skipping pm2 save so the dump keeps its last good state. Run \`pm2 save\` yourself once they are."
    return 0
  fi
  pm2_clean save
}

# .env reading with shell builtins only, so a value never appears in any
# process's argv (/proc/<pid>/cmdline is world-readable). Nothing here logs a
# value; the callers only ask whether a key is present.
env_file_get() {  # $1=file $2=KEY -> value on stdout ('' if absent). Never echo the result.
  local file="$1" key="$2" line val found=0
  [ -r "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"                 # ltrim
    case "$line" in ''|'#'*) continue;; esac
    case "$line" in
      export[[:space:]]*) line="${line#export}"; line="${line#"${line%%[![:space:]]*}"}";;
    esac
    case "$line" in "$key="*) ;; *) continue;; esac
    val="${line#*=}"
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}";;              # "quoted"
      \'*\') val="${val#\'}"; val="${val%\'}";;              # 'quoted'
      *)     val="${val%"${val##*[![:space:]]}"}";;          # bare: rtrim
    esac
    found=1                                                  # last one wins, like a shell
  done < "$file"
  [ "$found" -eq 1 ] && printf '%s' "$val"
  return 0
}
env_file_has() { [ -n "$(env_file_get "$1" "$2")" ]; }      # present AND non-empty

check_env() {
  # The app runs without either key — uploads fail closed without
  # UPLOAD_TOKEN, the AI scan is disabled without ANTHROPIC_API_KEY — so this
  # only warns. Both live in ./.env and nowhere else on the box.
  [ -f "$ENV_FILE" ] || { warn "$ENV_FILE is missing — uploads and AI scans are disabled until it exists (see .env.example)"; return 0; }
  env_file_has "$ENV_FILE" UPLOAD_TOKEN || warn "$ENV_FILE has no UPLOAD_TOKEN — /api/upload fails closed"
  env_file_has "$ENV_FILE" ANTHROPIC_API_KEY || warn "$ENV_FILE has no ANTHROPIC_API_KEY — the AI scanner is disabled"
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis. Both are printed whatever happens.
  #
  # Pass/fail is the LOCAL port answering HTTP at all — any status code —
  # retried up to PROBE_TRIES times a second apart, since the app re-enqueues
  # its queues at startup and may still be booting when pm2 reports it online.
  # The public side only warns: it also depends on DNS and TLS.
  local lcode="" pcode i
  for ((i = 1; i <= PROBE_TRIES; i++)); do
    lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/healthz" || true)"
    [ "$lcode" != "000" ] || lcode=""   # curl's code for "never connected"
    [ -z "$lcode" ] || break
    sleep 1
  done
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/healthz" || true)"
  [ "$pcode" != "000" ] || pcode=""
  printf 'local:     http://127.0.0.1:%s/healthz  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable after $PROBE_TRIES tries}"
  printf 'public:    https://%s/healthz  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
  [ -n "$lcode" ] || return 1
  case "$pcode" in
    ""|5*) warn "app answers locally but https://$FQDN/ is ${pcode:-unreachable} — look at nginx / DNS / TLS, not the app";;
  esac
}

cmd_deploy() {
  [ $# -eq 0 ] || die "unknown deploy option: $1 (see --help)"
  need_root deploy
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  # Decide start-vs-restart BEFORE the sync: a first deploy that cannot start
  # should fail here, not after a sync it did not need.
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then deploy again."
  check_env

  # Fast-forward only, deliberately not the template's `reset --hard`: this
  # repo's CLAUDE.md keeps main's history merge-commits-only and ff-only on
  # the way in, and the droplet checkout follows the same rule. If the
  # checkout has diverged (a hand edit or a stray commit on the box), stop and
  # say so rather than throw it away — the repo is the place to fix it.
  local before after
  before="$(git rev-parse --short HEAD)"
  log "Fast-forwarding $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git merge --ff-only --quiet "origin/$BRANCH" \
    || die "cannot fast-forward $ROOT to origin/$BRANCH — the checkout has diverged (git status / git log --oneline origin/$BRANCH..HEAD). Fix it in the repo; nothing was restarted."
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi
  # No install step: app.py and wgconvert/ are stdlib-only (no requirements.txt).
  # poppler-utils and tesseract-ocr are apt packages, installed once per box.

  case "$state" in
    "not registered")
      log "pm2 start ${START_CMD[*]}  ($APP, first registration)"
      pm2_clean start "${START_CMD[@]}"
      state="$(pm2_state)" || die "pm2 start ran but the process list is unreadable — $state"
      [ "$state" != "not registered" ] \
        || die "pm2 start ran but nothing named $APP is registered — START_CMD must name it (--name $APP)."
      ;;
    *)
      log "pm2 restart $APP"
      pm2_clean restart "$APP"
      ;;
  esac
  probe || die "$APP is not answering on 127.0.0.1:$PORT — deploy failed, nothing saved. See: lwcc logs"
  save_if_online
  log "deployed: $(git rev-parse --short HEAD)  $(git log -1 --format=%s)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "restart takes no options (see --help)"
  need_root restart
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then retry."
  [ "$state" != "not registered" ] || die "$APP is not registered with pm2 — nothing to restart. First start is: lwcc deploy"
  check_env
  log "pm2 restart $APP"
  pm2_clean restart "$APP"
  probe || die "$APP is not answering on 127.0.0.1:$PORT after restart. See: lwcc logs"
}

cmd_logs() {
  # `lwcc logs 200` (the old positional form) and `lwcc logs --lines 200`
  # both work; a bare number becomes --lines.
  case "${1:-}" in
    ''|*[!0-9]*) pm2_clean logs "$APP" --lines 100 "$@";;
    *) local n="$1"; shift; pm2_clean logs "$APP" --lines "$n" "$@";;
  esac
}

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       %s\n' "$(pm2_state || true)"
  if [ -f "$ENV_FILE" ]; then
    local k line=""
    for k in UPLOAD_TOKEN ANTHROPIC_API_KEY CONVERT_WORKERS AISCAN_WORKERS; do
      if env_file_has "$ENV_FILE" "$k"; then line="$line $k=present"; else line="$line $k=absent"; fi
    done
    printf '.env:     %s\n' "$line"
  else
    printf '.env:      (missing — uploads and AI scans disabled)\n'
  fi
  probe || true   # status reports, it does not judge — keep going to the cert
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

case "${1:-}" in
  deploy|redeploy) shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
