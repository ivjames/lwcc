# Copy to .env in the app dir (never committed) and restart the app.
# Generate a token:  openssl rand -hex 16
UPLOAD_TOKEN=

# Parallel conversion workers (default: CPU cores - 1, capped at 4).
# Conversion is CPU-bound (OCR) — more workers than cores gains nothing.
#CONVERT_WORKERS=2

# Enables the AI article scanner (/admin -> AI scan): reviews parsed guides
# for OCR misclassifications. Leave unset to disable scanning.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5.
#AISCAN_MODEL=
